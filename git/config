[alias]
        fzf-log = "!git-fzf-log.sh"
        fzf-worktree = "!git-fzf-worktree.sh"
        list-branches = "!git-list-branches.sh"
        list-reflog = "!git-back.sh"
        list-stashes = "!git-list-stashes.sh"

[commit]
        gpgSign = true
        signOff = true
        verbose = true

[fetch]
        parallel = 0

[gpg]
        format = "openpgp"

[gpg "openpgp"]
        program = "gpg"

[pull]
        autoSquash = true
        autoStash = true
        rebase = true

[push]
        autoSetupRemote = true
        default = "upstream"
        useForceIfIncludes = true

[rerere]
        enabled = true

[sendemail]
        from = "{{ users[0].real_name }} <{{ users[0].email }}>"
        smtpEncryption = "tls"
        smtpServer = "{{ users[0].smtp_server.host }}"
        smtpServerPort = {{ users[0].smtp_server.port }}
        smtpSslCertPath = "/etc/ssl/certs/ca-certificates.crt"
        smtpUser = "{{ users[0].email }}"

{% for source, replacement in git.redirects.items() %}
[url "{{ source }}"]
        insteadOf = "{{ replacement }}"
{% endfor %}

[user]
        email = "{{ users[0].email }}"
        name = "{{ users[0].real_name }}"
        signingKey = "{{ users[0].gpg_key }}"


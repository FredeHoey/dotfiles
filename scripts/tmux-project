#!/usr/bin/env bash
search_dir=$HOME/git/

if [[ $# -eq 1 ]]; then
    selected=$1
elif [[ $# -eq 2 ]]; then
    selected=$1
    selected_name=$2
else
    selected=$(find $search_dir -maxdepth 3 -regextype grep -regex ".*/.git" \
        | xargs dirname \
        | fzf-tmux -p --no-preview --bind "ctrl-g:beginning-of-line+put($search_dir)+print-query")
fi

if [[ -z $selected ]]; then
    exit 0
fi

if [[ ! -d $selected ]]; then
    mkdir -p $selected
    git -C $selected init
fi

if [[ -z $selected_name ]]; then
    selected_name=$(echo -n "${selected##$search_dir}" | tr ./- _)
fi

if [[ -z $TMUX ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name

export PS1="🐧\033[36m\t \033[0;10m\033[35m\u\033[0;10m@\033[0;10m\033[32m\h\033[0;10m \w\033[0;10m \033[0;10m\033[34m\\033[0;10m \033[0;10m\n\${IN_NIX_SHELL:+❆ }"
HISTCONTROL=ignoreboth:erasedups
HISTFILESIZE=100000
HISTSIZE=10000

export EDITOR={{ editor.program }}
export LAUNCHER={{ launcher.program }}
export BROWSER={{ browser.program }}

shopt -s histappend
shopt -s extglob
shopt -s globstar
shopt -s checkjobs

alias cdgr='cd $(git rev-parse --show-toplevel)'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias gba='{{dotfile_dir}}/scripts/git-back.sh'
alias gbr='{{dotfile_dir}}/scripts/git-list-branches.sh'
alias gd='git diff'
alias gl='{{dotfile_dir}}/scripts/git-fzf-log.sh'
alias grep='grep --color=auto'
alias gs='git status'
alias gst='{{dotfile_dir}}/scripts/git-list-stashes.sh'
alias gw='{{dotfile_dir}}/scripts/git-fzf-worktree.sh'
alias la='ls -lah'
alias ls='ls --color=auto -FC'
alias nd='nix develop'
alias rf='rm -rf'
alias venv='. .venv/bin/activate'

if [[ ! -v BASH_COMPLETION_VERSINFO ]]; then
  source "/etc/profile.d/bash_completion.sh"
fi

if [[ ! $- == *i* ]]; then 
  return 0
fi

eval "$(fzf --bash)"
eval "$(direnv hook bash)"

export GPG_TTY=$(tty)

ssh_auth_link="$HOME/.ssh/agent.sock"
if [[ -n "$SSH_AUTH_SOCK" && "$SSH_AUTH_SOCK" != "$ssh_auth_link" && -S "$SSH_AUTH_SOCK" ]]; then
    ln -snf "$SSH_AUTH_SOCK" "$ssh_auth_link"
elif [[ ! -S "$ssh_auth_link" ]]; then
    ln -snf "$(gpgconf --list-dirs agent-ssh-socket)" "$ssh_auth_link"
fi
export SSH_AUTH_SOCK="$ssh_auth_link"
unset ssh_auth_link

if [[ -f ~/.config/work.sh ]]; then
    source ~/.config/work.sh
fi

export PATH={{ dotfile_dir }}/scripts:$PATH
